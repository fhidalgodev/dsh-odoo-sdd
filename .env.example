# =============================================================================
# dsh-odoo-sdd — credentials template
# =============================================================================
# WHERE TO PUT THIS FILE (cascade — first existing location wins):
#   1. Path set in $ODOO_SDD_ENV_FILE          (explicit override)
#   2. <project>/.sdd/instances/<name>.env     (ONE TARGET PER FILE — see below)
#   3. <project>/.sdd/.env                     (single-target layout)
#   4. ~/.config/dsh-odoo-sdd/.env             (user scope — one file serves
#                                               all projects)
#   5. <project>/.env                          (legacy, still supported)
# Tip: the `odoo_setup` tool (mode=interactive) can scaffold this for you.
#
# SEVERAL TARGETS IN ONE PROJECT
# A workspace that talks to more than one Odoo (a local CE, a staging EE, a
# client's server) keeps ONE FILE PER TARGET instead of overwriting this one:
#
#   odoo_setup mode=instance instance=list
#   odoo_setup mode=instance instance=add name=staging url=https://stg.example.com db=stg username=ci
#   # fill ODOO_PASSWORD in .sdd/instances/staging.env by hand, then:
#   odoo_setup mode=authorize                    # a grant for THIS target only
#   odoo_setup mode=instance instance=use name=staging
#
# Authorization is per target (url + db + user), so two instances on one server
# are two grants. With several instances and none active, every connection tool
# REFUSES rather than picking one by order. An existing `.sdd/.env` keeps working
# as the instance `default` until you move it yourself.
#
# SECURITY RULES (enforced by the plugin at load time):
#   1. Copy this file to one of the locations above and fill in real values.
#   2. `.env` is gitignored — NEVER commit it, NEVER paste its values in chat,
#      logs, specs, or code. The plugin refuses to load a world-readable .env.
#   3. Prefer an Odoo API key (Settings > Users > API Keys) over the account
#      password. JSON-RPC `authenticate` accepts an API key in place of the
#      password, and a key can be revoked without changing the login.
#   4. Point ODOO_DB at a DISPOSABLE development/staging database. The SDD
#      loop installs/upgrades modules and writes test records on it.
# =============================================================================

# Base URL of the existing Odoo instance (no trailing slash).
# TRANSPORT RULE (enforced): http:// is only allowed for loopback hosts
# (localhost, 127.x, ::1, *.localhost). Any remote host MUST use https:// —
# otherwise the plugin refuses to load credentials (your API key would travel
# in clear text over the wire).
ODOO_URL=http://localhost:8069

# Database name to operate on (must be a dev/staging DB, never production).
ODOO_DB=dev_sdd

# Login of the admin/developer user used by the pipeline.
ODOO_USERNAME=admin

# The secret for ODOO_USERNAME. TWO names are accepted, and you only need ONE:
#   ODOO_API_KEY=<api key>            RECOMMENDED. Create it in
#                                     Settings > Users > API Keys (global scope).
#                                     Odoo accepts it wherever a password is
#                                     accepted over RPC, and it can be revoked
#                                     without touching the account.
#   ODOO_PASSWORD=<account password>  Works, but is the whole account.
# If BOTH are set, ODOO_PASSWORD wins and the plugin reports that the other was
# ignored, so a rotated credential cannot go unnoticed.
#
# EXCEPTION, and it is Odoo's rule: `odoo_session` and `odoo_import` need the WEB
# session, which authenticates interactive logins (`interactive: True`) and only
# consults the API-key table otherwise. Use an account password for those two.
ODOO_PASSWORD=

# Optional overrides -----------------------------------------------------------
# Environment of THIS target: dev | staging | production. Leave it out only if
# you never run the functional path: it refuses to apply any batch while the
# environment is undeclared, because assuming "dev" on a production database is
# the most expensive mistake this plugin can make. `production` additionally
# requires a declared backup and its own approval per batch.
# ODOO_SDD_ENVIRONMENT=dev
# ODOO_SDD_ENV_FILE=/absolute/path/to/.env   # alternative .env location
# ODOO_SDD_MAX_FAILURES=3                    # failures before deep diagnosis
# ODOO_SDD_MAX_ITERATIONS=5                  # verify/fix retries per criterion
